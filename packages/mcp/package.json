{
  "name": "@agentkbase/mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for an Agent KBase brain/ directory",
  "homepage": "https://agentkbase.com",
  "bugs": "https://github.com/m-qm/project-brain/issues",
  "keywords": ["agent", "cursor", "mcp", "knowledge-base", "brain"],
  "type": "module",
  "files": ["dist"],
  "publishConfig": {
