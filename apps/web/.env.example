# Copy to apps/web/.env.local for local dev (gitignored).

# Required: remote MCP (POST /mcp). Fail closed when unset — every request returns 401.
# Generate a long random string; set the same value in Vercel → Project → Environment Variables.
MCP_API_KEY=

# Optional: where hosted scan profiles are stored (default .agentkbase/hosted-profiles under cwd).
# AGENTKBASE_HOSTED_PROFILE_DIR=

# Other server keys (waitlist, extract on private deploys): see learn/07-extract-from-website.md

# Telegram setup bot. Token stays on the server. Name is the public @handle, without @.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_NAME=agentkbase_bot
# Chat replies use a model when one of these is set. Without a key, the bot still qualifies the lead from a short script.
# This does not turn on public website extract. Leave AGENTKBASE_ALLOW_SERVER_LLM unset.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Lead email. Without RESEND_API_KEY the chat still replies and the lead is not emailed.
# RESEND_API_KEY=
# WAITLIST_NOTIFY_EMAIL=hello@agentkbase.com
# RESEND_FROM=Agent KBase <notifications@agentkbase.com>